        # m0015PredictiveAIAdversarialInputDetection [Disabled]
        user info: "AML.M0015 - Predictive AI Adversarial Input Detection"
        -> evadeAIModel
        
        # m0034DeepfakeDetection [Disabled]
        user info: "AML.M0034 - Deepfake Detection"
        -> evadeAIModel
        
        # m0035AIRedTeam [Disabled]
        user info: "AML.M0035 - AI Red Team"
        -> evadeAIModel
    }
    
    
    asset ExternalHarm {
        
        | financialHarm
            user info: "AML.T0048.000 - External Harms: Financial Harm"
        
        | userHarm
            user info: "AML.T0048.003 - External Harms: User Harm"
    }
    
    
    asset AIResearchMaterial {
        
        | prePrintRepositories
            user info: "AML.T0000.001 - Search Open Technical Databases: Pre-Print Repositories"
