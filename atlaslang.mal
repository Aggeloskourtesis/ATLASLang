include "enterpriselang.mal"

#id: "atlaslang"
#version: "1.0.0"




category AI {
    
    asset VictimIdentityInformation {
        
        | gatherVictimIdentityInformation
        user info: "AML.T0087 - Gather Victim Identity Information"
        -> hardware.consumerHardware,
        generativeAI.generativeAI
    }
    
    
    asset AIInfrastructure {
        
        | acquireInfrastructure
        user info: "AML.T0008 - Acquire Infrastructure"
        -> capability.developCapabilities,
        stagedCapability.stageCapabilities
        
        | masquerading
        user info: "AML.T0074 - Masquerading"
        -> browser.driveByCompromise
    }
    
    
    asset AIConsumerHardware {
        
        | consumerHardware
        user info: "AML.T0008.001 - Acquire Infrastructure: Consumer Hardware"
        -> attackImplementation.obtainAdversarialAIAttackImplementation
    }
    
    
    asset AIAttackSoftwareTool {
        
        | generateMaliciousCommands
        user info: "AML.T0102 - Generate Malicious Commands"
        -> hostOS.dataFromLocalSystem
        
        | softwareTools
        user info: "AML.T0016.001 - Obtain Capabilities: Software Tools"
        -> account.establishAccounts,
        obtainedCapability.obtainCapabilities
        
        # m0020GenerativeAIGuardrails [Disabled]
        user info: "AML.M0020 - Generative AI Guardrails"
        -> generateMaliciousCommands
        
        
        # m0022GenerativeAIModelAlignment [Disabled]
        user info: "AML.M0022 - Generative AI Model Alignment"
        -> generateMaliciousCommands
    }
    
    asset AIBackendService extends Service {
        
        | applicationAccessToken
        user info: "AML.T0091.000 - Use Alternate Authentication Material: Application Access Token"
        +> aiApplication.aiEnabledProductOrService
        
        
        & exploitationForCredentialAccess
        user info: "AML.T0106 - Exploitation for Credential Access"
        +> attemptExploitationForDefenseEvasion
        
        
        & exploitationForDefenseEvasion
        user info: "AML.T0107 - Exploitation for Defense Evasion"
        +> os.validAccounts
        
        
        # m0016VulnerabilityScanning [Disabled]
        user info: "AML.M0016 - Vulnerability Scanning"
        -> exploitationForCredentialAccess,
        exploitationForDefenseEvasion
        
        
        # m0019ControlAccessInProduction [Disabled]
        user info: "AML.M0019 - Control Access to AI Models and Data in Production"
        -> applicationAccessToken
    }
    
    asset EnterpriseResourceDiscovery {
        
        | enterpriseResourceDiscovery
        user info: "AML.T0075 - Enterprise Resource Discovery"
        -> proxyTool.softwareTools
    }
    
    
    asset FraudulentAccount {
        
        | establishAccounts
        user info: "AML.T0021 - Establish Accounts"
        -> targetSystem.aiEnabledProductOrService,
        repositoryOS.dataFromInformationRepositories
        
        | impersonation
        user info: "AML.T0073 - Impersonation"
        -> impact.financialHarm,
        malwareHost.masquerading
        
        # m0005ControlAccessAtRest [Disabled]
        user info: "AML.M0005 - Control Access to AI Models and Data at Rest"
        -> establishAccounts
        
        # m0019ControlAccessInProduction [Disabled]
        user info: "AML.M0019 - Control Access to AI Models and Data in Production"
        -> establishAccounts
        
        # m0042ThreatIntelligenceProgram [Disabled]
        user info: "AML.M0042 - Threat Intelligence Program"
        -> impersonation
    }
    
    asset HFOrganizationAccount extends FraudulentAccount {
        
        | establishAccounts
        +> impersonation
        
        | impersonation
        +> repositoryModel.fullAIModelAccess
    }
    
    
    
    asset FacialRecognitionSystem {
        
        | aiEnabledProductOrService
        user info: "AML.T0047 - AI-Enabled Product or Service"
