        user info: "AML.M0000 - Limit Public Release of Information"
        -> searchOpenTechnicalDatabases,
        searchApplicationRepositories,
        searchOpenAIVulnerabilityAnalysis,
        searchVictimOwnedWebsites,
        searchOpenWebsitesDomains,
        gatherRAGIndexedTargets
        
        # m0019ControlAccessInProduction [Disabled]
        user info: "AML.M0019 - Control Access to AI Models and Data in Production"
        -> activeScanning
        
        # m0032SegmentationOfAIAgentComponents [Disabled]
        user info: "AML.M0032 - Segmentation of AI Agent Components"
        -> activeScanning

        # m0039AIHoneypots [Disabled]
        user info: "AML.M0039 - AI Honeypots"
        -> searchOpenTechnicalDatabases,
