include "enterpriselang.mal"

#id: "atlaslang"
#version: "1.0.0"




category AI {
    
    asset VictimIdentityInformation {
        
        | gatherVictimIdentityInformation
        user info: "AML.T0087 - Gather Victim Identity Information"
        -> hardware.consumerHardware
    }
    
    
    asset AIConsumerHardware {
        
        | consumerHardware
        user info: "AML.T0008.001 - Acquire Infrastructure: Consumer Hardware"
        -> attackImplementation.obtainAdversarialAIAttackImplementation
    }
    
    
    asset AIAttackSoftwareTool {
        
        | softwareTools
        user info: "AML.T0016.001 - Obtain Capabilities: Software Tools"
        -> account.establishAccounts
    }
    
    
    asset FraudulentAccount {
        
        | establishAccounts
        user info: "AML.T0021 - Establish Accounts"
        -> targetSystem.aiEnabledProductOrService
        
        # m0005ControlAccessAtRest [Disabled]
        user info: "AML.M0005 - Control Access to AI Models and Data at Rest"
        -> establishAccounts
        
        # m0019ControlAccessInProduction [Disabled]
        user info: "AML.M0019 - Control Access to AI Models and Data in Production"
        -> establishAccounts
    }
    
    
    asset FacialRecognitionSystem {
        
        | aiEnabledProductOrService
        user info: "AML.T0047 - AI-Enabled Product or Service"
        -> evadeAIModel
        
        | evadeAIModel
        user info: "AML.T0015 - Evade AI Model"
        -> impact.financialHarm
        
        # m0024AITelemetryLogging [Disabled]
        user info: "AML.M0024 - AI Telemetry Logging"
        -> aiEnabledProductOrService
        
        # m0003PredictiveAIModelHardening [Disabled]
        user info: "AML.M0003 - Predictive AI Model Hardening"
        -> evadeAIModel
        
        # m0006PredictiveAIEnsembles [Disabled]
        user info: "AML.M0006 - Predictive AI Ensembles"
        -> evadeAIModel
        
        # m0009PredictiveAIMultiSensorFusion [Disabled]
