associations {
    
    
    // AML.CS0000
    
    AIResearchMaterial [researchMaterial] * <--Identifies--> * [trainingData] TrainingData
    
    TrainingData [trainingData] * <--UsedToCreate--> * [proxyModel] ProxyAIModel
    
    ProxyAIModel [proxyModel] * <--SupportsCrafting--> * [adversarialSample] AdversarialSample
    
    AIResearchMaterial [researchSource] * <--Finds--> * [publicArtifacts] PublicAIArtifacts
    
    PublicAIArtifacts [publicArtifacts] * <--SupportsDevelopment--> * [capability] AdversarialCapability
    
    AdversarialCapability [capability] * <--Develops--> * [generatedSample] AdversarialSample
    
    AdversarialSample [adversarialSample] * <--TestedAgainst--> 1 [targetModel] AIMalwareDetector
    
    
    // AML.CS0062

    LLMPrompt [prompt] * <--Targets--> 1 [aiAgent] AIAgent

    AIAgent [aiAgent] 1 <--Invokes--> * [tool] AITool

    AITool [tool] * <--Uses--> 1 [vectorStore] VectorStore

    VectorStore [vectorStore] * <--RunsOn--> 1 [os] OS
    
    
    // AML.CS0002 associations
    
    AdversarialAttackImplementation [attackImplementation] * <--Produces--> * [adversarialSample] AdversarialSample
    
    AdversarialSample [poisoningSamples] * <--SubmittedTo--> * [dataSupplyChain] AISupplyChainData
    
    AISupplyChainData [dataSupplyChain] * <--Poisons--> * [trainingData] TrainingData
    
    
    // AML.CS0003 associations
    
    AIResearchMaterial [researchForProduct] * <--IdentifiesProduct--> * [targetProduct] AIMalwareDetector
    
    AIMalwareDetector [sourceDetector] * <--InformsDevelopment--> * [capability] AdversarialCapability
    
    AdversarialCapability [manualCapability] * <--DevelopsManualSample--> * [manualSample] AdversarialSample
    
    AdversarialSample [evasionSample] * <--TargetsForEvasion--> * [evasionTarget] AIMalwareDetector
    
    
    // AML.CS0004 associations
    
    VictimIdentityInformation [victimIdentity] * <--Supports--> * [hardware] AIConsumerHardware
    
    AIConsumerHardware [hardware] * <--Enables--> * [attackImplementation] AdversarialAttackImplementation
    
    AdversarialAttackImplementation [cameraAttackImplementation] * <--Uses--> * [softwareTool] AIAttackSoftwareTool
    
    AIAttackSoftwareTool [softwareTool] * <--Supports--> * [account] FraudulentAccount
    
    FraudulentAccount [account] * <--Accesses--> * [targetSystem] FacialRecognitionSystem
    
    FacialRecognitionSystem [targetSystem] * <--Causes--> * [impact] ExternalHarm
    
    
    // AML.CS0005 associations
    
    TrainingData [trainingData] * <--PairsWith--> * [publicArtifacts] PublicAIArtifacts
    
    PublicAIArtifacts [publicArtifacts] * <--TargetsService--> * [targetService] MachineTranslationService
    
    MachineTranslationService [targetService] * <--QueriedBy--> * [proxyModel] ProxyAIModel
    
    ProxyAIModel [proxyModel] * <--Causes--> * [externalHarm] ExternalHarm
    
    ExternalHarm [externalHarm] * <--EnablesTransfer--> * [adversarialSample] AdversarialSample
    
    AdversarialSample [transferSample] * <--TransfersTo--> * [targetService] MachineTranslationService
    
    
    // AML.CS0006 associations
    
    FraudulentAccount [repositoryAccount] * <--AccessesRepository--> * [repositoryOS] AIRepositoryOS
    
    AIRepositoryOS [repositoryOS] * <--ExposesAIArtifacts--> * [publicArtifacts] PublicAIArtifacts
    
    PublicAIArtifacts [clearviewArtifacts] * <--ImpactsIntegrityOf--> * [integrityTarget] FacialRecognitionSystem
    
    
    // AML.CS0007 associations
    
    PublicAIArtifacts [gpt2Artifacts] * <--SupportsDevelopmentWorkspace--> * [developmentWorkspace] AIDevelopmentWorkspace
    
    AIDevelopmentWorkspace [developmentWorkspace] * <--TrainsProxyModel--> * [proxyModel] ProxyAIModel
    
    
    // AML.CS0008 association
    
    AIMalwareDetector [replicationTarget] * <--ReplicatedBy--> * [proxyModel] ProxyAIModel
    
    
    // AML.CS0009 associations
    
    OnlineLearningAIModel [onlineLearningModel] * <--FeedsInteractionsInto--> * [poisoningSupplyChain] AISupplyChainData
    
    TrainingData [poisonedTrainingData] * <--DegradesIntegrityOf--> * [integrityTarget] OnlineLearningAIModel
    
    
    // AML.CS0010 associations
    
    AIResearchMaterial [azureResearch] * <--FindsValidAccount--> * [targetOS] AIServiceOS
    
    AIServiceOS [azureServiceOS] * <--AllowsArtifactCollection--> * [artifactCollection] AIArtifactCollection
    
    AIArtifactCollection [azureArtifactCollection] * <--ExfiltratesThrough--> * [exfiltration] AIExfiltration
    
    AIExfiltration [azureExfiltration] * <--EnablesWhiteBoxOptimization--> * [adversarialSample] AdversarialSample
    
    AdversarialSample [whiteBoxSample] * <--TargetsInferenceService--> * [inferenceTarget] AIInferenceService
    
    
    // AML.CS0011 associations
    
    PublicAIArtifacts [edgePublicArtifacts] * <--ProvidesInferenceAccess--> * [inferenceService] AIInferenceService
    
    AIInferenceService [publicInferenceService] * <--SupportsBlackBoxOptimization--> * [blackBoxSample] AdversarialSample
    
    AdversarialSample [edgeAdversarialSample] * <--EvadesEdgeModel--> * [edgeEvasionTarget] PredictiveAIModel
    
    
    // AML.CS0012 associations
    
    AIServiceOS [faceServiceOS] * <--ProvidesAuthenticatedInferenceAccess--> * [inferenceService] AIInferenceService
    
    AIInferenceService [ontologyService] * <--RevealsOntologyForDataset--> * [ontologyData] TrainingData
    
    AdversarialSample [physicalAdversarialPattern] * <--ProducesPhysicalCountermeasure--> * [physicalCountermeasure] PhysicalCountermeasure
    
    PhysicalCountermeasure [physicalCountermeasure] * <--DeployedInto--> * [physicalEnvironment] PhysicalAIEnvironment
    
    PhysicalAIEnvironment [physicalEnvironment] * <--TargetsPhysicalModel--> * [targetModel] PredictiveAIModel
    
    
    // AML.CS0013 associations
    
    PublicAIArtifacts [mobileModelArtifact] * <--ProvidesFullModelAccess--> * [fullAccessTarget] MobileAIModel
    
    MobileAIModel [accessibleModel] * <--EnablesBackdoorDevelopment--> * [capability] AdversarialCapability
    
    AdversarialCapability [backdoorCapability] * <--ModifiesArchitectureOf--> * [modifiedModel] MobileAIModel
    
    MobileAIModel [verifiedBackdooredModel] * <--IntroducedViaSupplyChain--> * [modelSupplyChain] AISupplyChainModel
    
    AISupplyChainModel [modelSupplyChain] * <--ActivatedBy--> * [trigger] BackdoorTrigger
    
    BackdoorTrigger [trigger] * <--PlacedIn--> * [physicalEnvironment] PhysicalAIEnvironment
    
    
    // AML.CS0014 associations
    
    AIMalwareDetector [grayBoxDetector] * <--LabelsDataset--> * [labeledDataset] TrainingData
    
    ProxyAIModel [grayBoxProxy] * <--SupportsAttackDevelopment--> * [capability] AdversarialCapability
    
    AdversarialCapability [grayBoxCapability] * <--CreatesTransferSample--> * [transferSample] AdversarialSample
    
    
    // AML.CS0015 associations
    
    AISupplyChainSoftware [compromisedSoftware] * <--ExecutesOn--> * [hostOS] AISupplyChainHostOS
    
    AISupplyChainHostOS [collectionHost] * <--ExfiltratesThrough--> * [exfiltration] AIExfiltration
    
    
    // AML.CS0016 associations
    
    AIResearchMaterial [mathGPTResearch] * <--IdentifiesPublicLLMApplication--> * [publicLLMApp] PublicFacingLLMApplication
    
    PublicFacingLLMApplication [mathGPTApp] * <--InvokesMathTool--> * [tool] AITool
    
    AITool [credentialTool] * <--RunsOnMathGPTHost--> 1 [hostOS] MathGPTHostOS
    
    MathGPTHostOS [mathGPTHost] * <--CausesFinancialImpact--> * [impact] ExternalHarm
    
    AITool [dosTool] * <--CausesServiceImpact--> * [serviceImpact] AIServiceImpact
    
    
    //Scenario 1 associations
    
    AdversarialCapability [ctganCapability] * <--EnablesPreparation--> * [attackPreparation] AttackPreparation
    
    CTAttackOS [sourceOS] * <--CollectsCTData--> * [ctImage] AdversarialSample
    
    AdversarialSample [adversarialSample] * <--InjectedInto--> * [ctNetwork] CTImageNetwork
    
    CTImageNetwork [ctNetwork] * <--FeedsModel--> * [targetModel] AIMalwareDetector
    
    AIMalwareDetector [malwareDetector] * <--Causes--> * [externalHarm] ExternalHarm
    
    
    //Scerario 2 associations
    
    AdversarialAttackImplementation [bgmsImplementation] * <--EnablesVulnerabilityResearch--> * [vulnerabilityPreparation] AttackPreparation
    
    BGMSMobileOS [sourceOS] * <--CollectsAIArtifact--> * [artifact] AIArtifactCollection
    
    AIArtifactCollection [artifactCollection] * <--SupportsCrafting--> * [adversarialSample] AdversarialSample
    
    AdversarialSample [bgmsSample] * <--InjectedThrough--> * [bgmsChannel] BGMSBluetoothChannel
    
    BGMSBluetoothChannel [bgmsChannel] * <--FeedsModel--> * [targetModel] PredictiveAIModel
    
    PredictiveAIModel [predictiveModel] * <--Causes--> * [externalHarm] ExternalHarm
    
    
    //Scerario 3 associations
    
    LLMPrompt [fabricatedPrompt] * <--PreparesBrowserAttack--> * [browserPreparation] AttackPreparation
    
    PromptManipulationNetwork [promptNetwork] * <--CarriesManipulatedPromptTo--> * [llmConversation] LLMConversation
    
    LLMConversation [conversation] * <--PersistsIn--> * [agentContext] AIAgentContext
    
    AIAgentContext [agentContext] * <--Causes--> * [externalHarm] ExternalHarm
    
}
