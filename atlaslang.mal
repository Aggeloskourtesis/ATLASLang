        user info: "AML.T0011.003 - User Execution: Malicious Link"
        -> targetService.attemptExploitationForCredentialAccess
        
        # m0011RestrictLibraryLoading [Disabled]
        user info: "AML.M0011 - Restrict Library Loading"
        -> userExecution,
