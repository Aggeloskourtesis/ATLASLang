        -> proxyTool.softwareTools,
        enterpriseTarget.enterpriseEnvironmentDiscovery,
        nextExfiltrationViaCyberMeansAIExfiltration.exfiltrationViaCyberMeans
    }
    
    asset WebSessionCredential {
        
