include "enterpriselang.mal"

#id: "atlaslang"
#version: "1.0.0"




category AI {
    
    asset VictimIdentityInformation {
        
        | gatherVictimIdentityInformation
        user info: "AML.T0087 - Gather Victim Identity Information"
        -> hardware.consumerHardware,
        generativeAI.generativeAI,
        nextAiSupplyChainCompromiseAISupplyChainModel.aiSupplyChainCompromise,
        nextPromptInfiltrationViaPublicFacingApplicationPublicFacingLLMApplication.promptInfiltrationViaPublicFacingApplication,
        nextSpearphishingViaSocialEngineeringLLMSocialEngineeringLLM.spearphishingViaSocialEngineeringLLM
    }
    
    
    asset AIInfrastructure {
        
        | acquireInfrastructure
        user info: "AML.T0008 - Acquire Infrastructure"
        -> capability.developCapabilities,
        stagedCapability.stageCapabilities,
        infrastructurePrompt.llmPromptCrafting,
        nextStageCapabilitiesLLMStagedCapability.stageCapabilities
        
        | aiServiceProxies
        user info: "AML.T0008.005 - Acquire Infrastructure: AI Service Proxies"
        -> accountHost.validAccounts
        
        | masquerading
        user info: "AML.T0074 - Masquerading"
        -> browser.driveByCompromise,
        nextAiSupplyChainCompromiseAISupplyChainModel.aiSupplyChainCompromise
        
        | compromiseInfrastructure
        user info: "AML.T0128 - Compromise Infrastructure"
        -> deployedAgent.deployAIAgent
        
        | centralizedAIServiceRequestRouting
        user info: "AML.T0140 - Centralized AI Service Request Routing"
        -> inferenceService.exfiltrationViaAIInferenceAPI,
        infrastructurePrompt.llmPromptCrafting,
        aiServiceRequestMetadataSanitization
        
        | aiServiceRequestMetadataSanitization
        user info: "AML.T0141 - AI Service Request Metadata Sanitization"
        -> inferenceService.discoverAIModelOutputs
        
        # m0016VulnerabilityScanning [Disabled]
        user info: "AML.M0016 - Vulnerability Scanning"
        -> compromiseInfrastructure
        
        # m0042ThreatIntelligenceProgram [Disabled]
        user info: "AML.M0042 - Threat Intelligence Program"
        -> centralizedAIServiceRequestRouting
        
    }
    
    
    asset AIConsumerHardware {
        
        | consumerHardware
        user info: "AML.T0008.001 - Acquire Infrastructure: Consumer Hardware"
        -> attackImplementation.obtainAdversarialAIAttackImplementation
    }
    
    
    asset AIServiceWebInterface {
        
        | aiServiceWebInterface
        user info: "AML.T0114 - AI Service Web Interface"
        -> exfiltrationTool.exfiltrationViaAIAgentToolInvocation
        
