        registryTarget.exploitPublicFacingApplication,
        callChainConfiguration.callChains
        
        | activeScanning
        user info: "AML.T0006 - Active Scanning"
        -> targetCluster.exploitPublicFacingApplication
        
        | probeAIAgentTriggerChannels
        user info: "AML.T0006.003 - Probe AI Agent Trigger Channels"
        -> craftedPrompt.llmPromptCrafting
        
        | gatherRAGIndexedTargets
        user info: "AML.T0064 - Gather RAG-Indexed Targets"
        -> publicLLMApp.aiEnabledProductOrService
        
        | searchOpenWebsitesDomains
        user info: "AML.T0095 - Search Open Websites/Domains"
        -> craftedPrompt.llmPromptCrafting
        
        | codeRepositories
        user info: "AML.T0095.000 - Search Open Websites/Domains: Code Repositories"
        -> publicArtifacts.aiAgentConfiguration
            
