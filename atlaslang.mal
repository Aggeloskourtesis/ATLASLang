        craftAdversarialData
        
        # m0008ValidateAIModel [Disabled]
        user info: "AML.M0008 - Validate AI Model"
        -> craftAdversarialData
        
        # m0010PredictiveAIInputRestoration [Disabled]
        user info: "AML.M0010 - Predictive AI Input Restoration"
        -> manualModification,
