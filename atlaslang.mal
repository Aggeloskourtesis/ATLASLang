        # m0024AITelemetryLogging [Disabled]
        user info: "AML.M0024 - AI Telemetry Logging"
        -> aiEnabledProductOrService
        
        # m0002PredictiveAIOutputObfuscation [Disabled]
        user info: "AML.M0002 - Predictive AI Output Obfuscation"
        -> discoverAIModelOutputs,
        verifyAttack
        
        # m0012EncryptSensitiveInformation [Disabled]
        user info: "AML.M0012 - Encrypt Sensitive Information"
        -> discoverAIModelOutputs
        
        # m0017AIModelDistributionMethods [Disabled]
        user info: "AML.M0017 - AI Model Distribution Methods"
        -> discoverAIModelOutputs
        
        # m0019ControlAccessInProduction [Disabled]
        user info: "AML.M0019 - Control Access to AI Models and Data in Production"
        -> discoverAIModelOutputs,
        verifyAttack
        
        # m0004LimitAIServiceQueryVolumeAndRate [Disabled]
        user info: "AML.M0004 - Limit AI Service Query Volume and Rate"
        -> verifyAttack
        
        # m0005ControlAccessAtRest [Disabled]
        user info: "AML.M0005 - Control Access to AI Models and Data at Rest"
        -> verifyAttack
        
        # m0003PredictiveAIModelHardening [Disabled]
        user info: "AML.M0003 - Predictive AI Model Hardening"
        -> evadeAIModel
        
        # m0006PredictiveAIEnsembles [Disabled]
        user info: "AML.M0006 - Predictive AI Ensembles"
        -> evadeAIModel
        
        # m0009PredictiveAIMultiSensorFusion [Disabled]
        user info: "AML.M0009 - Predictive AI Multi-Sensor Fusion"
        -> evadeAIModel
        
        # m0010PredictiveAIInputRestoration [Disabled]
        user info: "AML.M0010 - Predictive AI Input Restoration"
        -> evadeAIModel
        
        # m0015PredictiveAIAdversarialInputDetection [Disabled]
        user info: "AML.M0015 - Predictive AI Adversarial Input Detection"
        -> evadeAIModel
        
        # m0034DeepfakeDetection [Disabled]
        user info: "AML.M0034 - Deepfake Detection"
        -> evadeAIModel
        
        # m0035AIRedTeam [Disabled]
        user info: "AML.M0035 - AI Red Team"
        -> evadeAIModel
    }
    

    asset LLMPrompt {

        | llmPromptCrafting
            user info: "AML.T0065 - LLM Prompt Crafting"
            -> aiAgent.aiEnabledProductOrService,
            browserPreparation.developMalware,
            browserPreparation.obtainMalware
    }


    asset AIAgent {

        | aiEnabledProductOrService
            user info: "AML.T0047 - AI-Enabled Product or Service"
            -> directPromptInjection

        | directPromptInjection
            user info: "AML.T0051.000 - LLM Prompt Injection: Direct"
            -> tool.aiAgentToolInvocation
            
        # m0024AITelemetryLogging [Disabled]
            user info: "AML.M0024 - AI Telemetry Logging"
            -> aiEnabledProductOrService,
               directPromptInjection

        # m0033InputOutputValidationAgentComponents [Disabled]
            user info: "AML.M0033 - Input and Output Validation for AI Agent Components"
            -> directPromptInjection

        # m0035AIRedTeam [Disabled]
            user info: "AML.M0035 - AI Red Team"
            -> directPromptInjection
    }
    
    asset LLMConversation {
        
        | llmPromptInjection
        user info: "AML.T0051 - LLM Prompt Injection"
        -> agentContext.contextPoisoningThread
        
        # m0019ControlAccessInProduction [Disabled]
        user info: "AML.M0019 - Control Access to AI Models and Data in Production"
        -> llmPromptInjection
        
        # m0020GenerativeAIGuardrails [Disabled]
        user info: "AML.M0020 - Generative AI Guardrails"
        -> llmPromptInjection
        
        # m0021GenerativeAIGuidelines [Disabled]
        user info: "AML.M0021 - Generative AI Guidelines"
        -> llmPromptInjection
        
        # m0022GenerativeAIModelAlignment [Disabled]
        user info: "AML.M0022 - Generative AI Model Alignment"
        -> llmPromptInjection
        
        # m0024AITelemetryLogging [Disabled]
        user info: "AML.M0024 - AI Telemetry Logging"
        -> llmPromptInjection
        
        # m0033InputOutputValidationAgentComponents [Disabled]
        user info: "AML.M0033 - Input and Output Validation for AI Agent Components"
        -> llmPromptInjection
        
        # m0035AIRedTeam [Disabled]
        user info: "AML.M0035 - AI Red Team"
        -> llmPromptInjection
    }
    
    
    asset AIAgentContext {
        
        | contextPoisoningThread
        user info: "AML.T0080.001 - AI Agent Context Poisoning: Thread"
        -> externalHarm.userHarm
        
        # m0035AIRedTeam [Disabled]
        user info: "AML.M0035 - AI Red Team"
        -> contextPoisoningThread
    }
    
    asset PromptManipulationNetwork extends InternalNetwork {
        
        & transmittedDataManipulation
        +> llmConversation.llmPromptInjection
    }


    asset AITool {

        | aiAgentToolInvocation
            user info: "AML.T0053 - AI Agent Tool Invocation"
            -> vectorStore.vulnerableFilterEvaluation
        
        # m0020GenerativeAIGuardrails [Disabled]
        user info: "AML.M0020 - Generative AI Guardrails"
        -> aiAgentToolInvocation
        
        # m0021GenerativeAIGuidelines [Disabled]
        user info: "AML.M0021 - Generative AI Guidelines"
        -> aiAgentToolInvocation
        
        # m0022GenerativeAIModelAlignment [Disabled]
        user info: "AML.M0022 - Generative AI Model Alignment"
        -> aiAgentToolInvocation
        
        # m0024AITelemetryLogging [Disabled]
        user info: "AML.M0024 - AI Telemetry Logging"
        -> aiAgentToolInvocation
        
        # m0026PrivilegedAIAgentPermissions [Disabled]
        user info: "AML.M0026 - Privileged AI Agent Permissions Configuration"
        -> aiAgentToolInvocation
        
        # m0027SingleUserAIAgentPermissions [Disabled]
        user info: "AML.M0027 - Single-User AI Agent Permissions Configuration"
        -> aiAgentToolInvocation
        
        # m0028AIAgentToolsPermissions [Disabled]
        user info: "AML.M0028 - AI Agent Tools Permissions Configuration"
        -> aiAgentToolInvocation
        
        # m0029HumanInTheLoop [Disabled]
        user info: "AML.M0029 - Human In-the-Loop for AI Agent Actions"
        -> aiAgentToolInvocation
        
        # m0030RestrictToolInvocationOnUntrustedData [Disabled]
        user info: "AML.M0030 - Restrict AI Agent Tool Invocation on Untrusted Data"
        -> aiAgentToolInvocation
        
        # m0032SegmentationOfAIAgentComponents [Disabled]
        user info: "AML.M0032 - Segmentation of AI Agent Components"
        -> aiAgentToolInvocation
        
        # m0033InputOutputValidationAgentComponents [Disabled]
        user info: "AML.M0033 - Input and Output Validation for AI Agent Components"
        -> aiAgentToolInvocation
        
        # m0035AIRedTeam [Disabled]
        user info: "AML.M0035 - AI Red Team"
        -> aiAgentToolInvocation
    }
    
    
    asset AISupplyChainData {
        
        | aiSupplyChainCompromiseData
            user info: "AML.T0010.002 - AI Supply Chain Compromise: Data"
            -> trainingData.poisonTrainingData
        
        # m0005ControlAccessAtRest [Disabled]
        user info: "AML.M0005 - Control Access to AI Models and Data at Rest"
        -> aiSupplyChainCompromiseData
        
        # m0007SanitizeTrainingData [Disabled]
        user info: "AML.M0007 - Sanitize Training Data"
        -> aiSupplyChainCompromiseData
        
        # m0014VerifyAIArtifacts [Disabled]
        user info: "AML.M0014 - Verify AI Artifacts"
        -> aiSupplyChainCompromiseData
        
        # m0025MaintainAIDatasetProvenance [Disabled]
        user info: "AML.M0025 - Maintain AI Dataset Provenance"
        -> aiSupplyChainCompromiseData
        
        # m0035AIRedTeam [Disabled]
        user info: "AML.M0035 - AI Red Team"
        -> aiSupplyChainCompromiseData
    }


    asset VectorStore {

        | vulnerableFilterEvaluation
            user info: "Attacker-controlled filter reaches unsafe eval() execution"
            -> os.commandAndScriptingInterpreter

        # safeFilterEvaluation
            user info: "Avoid dynamic evaluation of attacker-controlled filter expressions"
            -> vulnerableFilterEvaluation
    }
    
    asset CTAttackOS extends OS {
        
        | dataFromLocalSystem
            +> ctImage.craftAdversarialData
    }
    
    asset CTImageNetwork extends InternalNetwork {
        
        & transmittedDataManipulation
            +> targetModel.evadeAIModel
    }
    
    asset BGMSMobileOS extends OS {
        
        & manInTheMiddle
        +> artifact.aiArtifactCollection
    }
    
    asset BGMSBluetoothChannel extends InternalNetwork {
        
        & transmittedDataManipulation
        +> targetModel.evadeAIModel
    }
}

associations {
    
    
    // AML.CS0000
    
    AIResearchMaterial [researchMaterial] * <--Identifies--> * [trainingData] TrainingData
    
    TrainingData [trainingData] * <--UsedToCreate--> * [proxyModel] ProxyAIModel
    
    ProxyAIModel [proxyModel] * <--SupportsCrafting--> * [adversarialSample] AdversarialSample
    
    AIResearchMaterial [researchSource] * <--Finds--> * [publicArtifacts] PublicAIArtifacts
    
    PublicAIArtifacts [publicArtifacts] * <--SupportsDevelopment--> * [capability] AdversarialCapability
    
    AdversarialCapability [capability] * <--Develops--> * [generatedSample] AdversarialSample
    
    AdversarialSample [adversarialSample] * <--TestedAgainst--> 1 [targetModel] AIMalwareDetector
    
    
    // AML.CS0062

    LLMPrompt [prompt] * <--Targets--> 1 [aiAgent] AIAgent

    AIAgent [aiAgent] 1 <--Invokes--> * [tool] AITool

    AITool [tool] * <--Uses--> 1 [vectorStore] VectorStore

    VectorStore [vectorStore] * <--RunsOn--> 1 [os] OS
    
    
    // AML.CS0002 associations
    
    AdversarialAttackImplementation [attackImplementation] * <--Produces--> * [adversarialSample] AdversarialSample
    
    AdversarialSample [poisoningSamples] * <--SubmittedTo--> * [dataSupplyChain] AISupplyChainData
    
    AISupplyChainData [dataSupplyChain] * <--Poisons--> * [trainingData] TrainingData
    
    
    // AML.CS0003 associations
    
    AIResearchMaterial [researchForProduct] * <--IdentifiesProduct--> * [targetProduct] AIMalwareDetector
    
    AIMalwareDetector [sourceDetector] * <--InformsDevelopment--> * [capability] AdversarialCapability
    
    AdversarialCapability [manualCapability] * <--DevelopsManualSample--> * [manualSample] AdversarialSample
    
    AdversarialSample [evasionSample] * <--TargetsForEvasion--> * [evasionTarget] AIMalwareDetector
    
    
    // AML.CS0004 associations
    
    VictimIdentityInformation [victimIdentity] * <--Supports--> * [hardware] AIConsumerHardware
    
    AIConsumerHardware [hardware] * <--Enables--> * [attackImplementation] AdversarialAttackImplementation
    
    AdversarialAttackImplementation [cameraAttackImplementation] * <--Uses--> * [softwareTool] AIAttackSoftwareTool
    
    AIAttackSoftwareTool [softwareTool] * <--Supports--> * [account] FraudulentAccount
    
    FraudulentAccount [account] * <--Accesses--> * [targetSystem] FacialRecognitionSystem
    
    FacialRecognitionSystem [targetSystem] * <--Causes--> * [impact] ExternalHarm
    
    
    //Scenario 1 associations
    
    AdversarialCapability [ctganCapability] * <--EnablesPreparation--> * [attackPreparation] AttackPreparation
    
    CTAttackOS [sourceOS] * <--CollectsCTData--> * [ctImage] AdversarialSample
    
    AdversarialSample [adversarialSample] * <--InjectedInto--> * [ctNetwork] CTImageNetwork
    
    CTImageNetwork [ctNetwork] * <--FeedsModel--> * [targetModel] AIMalwareDetector
    
    AIMalwareDetector [malwareDetector] * <--Causes--> * [externalHarm] ExternalHarm
    
    
    //Scerario 2 associations
    
    AdversarialAttackImplementation [bgmsImplementation] * <--EnablesVulnerabilityResearch--> * [vulnerabilityPreparation] AttackPreparation
    
    BGMSMobileOS [sourceOS] * <--CollectsAIArtifact--> * [artifact] AIArtifactCollection
    
    AIArtifactCollection [artifactCollection] * <--SupportsCrafting--> * [adversarialSample] AdversarialSample
    
    AdversarialSample [bgmsSample] * <--InjectedThrough--> * [bgmsChannel] BGMSBluetoothChannel
    
    BGMSBluetoothChannel [bgmsChannel] * <--FeedsModel--> * [targetModel] PredictiveAIModel
    
    PredictiveAIModel [predictiveModel] * <--Causes--> * [externalHarm] ExternalHarm
    
    
    //Scerario 3 associations
    
    LLMPrompt [fabricatedPrompt] * <--PreparesBrowserAttack--> * [browserPreparation] AttackPreparation
    
    PromptManipulationNetwork [promptNetwork] * <--CarriesManipulatedPromptTo--> * [llmConversation] LLMConversation
    
    LLMConversation [conversation] * <--PersistsIn--> * [agentContext] AIAgentContext
    
    AIAgentContext [agentContext] * <--Causes--> * [externalHarm] ExternalHarm
    
}
